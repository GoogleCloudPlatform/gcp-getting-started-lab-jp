# Skill working dirs (created at runtime) — must stay visible to agents:
# .migration/      -- NOT ignored: agents read their own phase outputs
# .iteration-log/  -- NOT ignored: harness iteration records live here

# Secrets — never committed
.env
.env.*
*.pem
*.key
*.crt
secrets/

# Terraform local state (state can contain resolved account details)
.terraform/
terraform.tfstate
terraform.tfstate.*
*.tfplan
crash.log

# Rendered manifests (deploy.sh output; regenerated every run)
k8s-build/

# Node
node_modules/
npm-debug.log*

# Go build artifacts
*.exe
catalog-api/catalog-api

# Local dev / OS
.DS_Store
.idea/
.vscode/
*.swp
tmp/
