# Deployment configuration (propagated by agents-cli deploy; the platform
# injects GOOGLE_CLOUD_PROJECT itself — it is a reserved variable).
GOOGLE_GENAI_USE_VERTEXAI=true
GOOGLE_CLOUD_PROJECT=aws-migration-501814
GOOGLE_CLOUD_LOCATION=global

# The rebinding: bedrock/jp.anthropic.claude-sonnet-4-6 became a native
# Gemini id (see policyapi/agent.py for the partner-Claude alternative).
MODEL_BINDING=gemini-3.7-flash
