# Skill working dirs (created at runtime) — must stay visible to agents:
# .migration/      -- NOT ignored: agents read their own phase outputs
# .iteration-log/  -- NOT ignored: per-run observation records live here
#
# costs/*.csv is also NOT ignored: the cost export is committed source material,
# regenerated deterministically by costs/make-usage-export.py.

# Secrets — never committed. deploy.sh generates the PostgreSQL administrator
# password and the Django SECRET_KEY at deploy time and writes them to a 0600
# temp file that it removes on exit.
.env
.env.*
*.pem
*.key
*.pfx
*.crt
*.publishsettings
secrets/
main.secrets.json

# Azure CLI / deployment scratch
.azure/
*.deployment.json.tmp

# Python — the app venv seed.sh builds, and build leftovers
__pycache__/
*.pyc
.venv/
venv/
app/staticfiles/
*.sqlite3

# Local dev / OS
.DS_Store
.idea/
.vscode/
*.swp
tmp/
